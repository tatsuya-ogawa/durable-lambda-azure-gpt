# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_MODEL=your-model
# AZURE_OPENAI_DEPLOYMENT=legacy-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# openai/v1 を使う場合は空にする

# Azure Webhook signing secret is provisioned by CDK and stored in SSM.

# Durable execution
DURABLE_EXECUTION_TIMEOUT=900
DURABLE_RETENTION_DAYS=14
# MAX_TOOL_STEPS=5

# API Gateway
INVOKE_API_KEY=change-me-too
